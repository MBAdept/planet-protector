; Engine configuration file.
config_version=5

[application]

config/name="Planet Protector"
config/description="Defend the solar system from waves of winged demons."
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="planet_protector"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)

[autoload]

Settings="*res://scripts/autoload/settings.gd"
InputRouter="*res://scripts/autoload/input_router.gd"
Assets="*res://scripts/autoload/assets.gd"
Run="*res://scripts/autoload/run_state.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=3
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
